{
  "name": "@fep/submit-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime service that receives the site's submission forms (brand, correction, verification, contact).",
  "scripts": {
    "start": "node --experimental-sqlite src/server.ts",
    "dev": "node --experimental-sqlite --watch src/server.ts",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fep/schema": "workspace:*",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
