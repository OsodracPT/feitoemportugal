---
import { HTML_LANG, t, type Alternates, type Lang } from '~/lib/i18n.ts';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
// Fixed order, so the switch does not swap places between the two languages.
const langs: Lang[] = ['pt', 'en'];
---

<div class="lang" role="group" aria-label={t(lang, 'lang.label')}>
  {
    langs.map((l) =>
      l === lang ? (
        <a class="lang__item lang__item--current" href={alternates[l]} aria-current="true" lang={HTML_LANG[l]} aria-label={t(l, `lang.${l}`)}>
          {t(lang, `lang.short_${l}`)}
        </a>
      ) : (
        <a class="lang__item" href={alternates[l]} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-label={t(l, `lang.${l}`)}>
          {t(lang, `lang.short_${l}`)}
        </a>
      ),
    )
  }
</div>

<style>
  .lang {
    display: flex;
  }

  .lang__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--fep-touch);
    min-height: var(--fep-touch);
    font-size: var(--fep-text-meta);
    font-weight: 700;
    color: var(--fep-accent);
    text-decoration: none;
  }

  .lang__item:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* On a phone only the other language shows: one tap, no wasted width. */
  .lang__item--current {
    display: none;
  }

  @media (min-width: 60rem) {
    .lang {
      border: 1.5px solid var(--fep-accent);
      border-radius: var(--fep-radius);
      overflow: hidden;
      margin-inline-start: var(--fep-space-2);
    }

    .lang__item {
      min-width: 0;
      min-height: 2.5rem;
      padding-inline: var(--fep-space-3);
    }

    .lang__item--current {
      display: flex;
      background: var(--fep-accent);
      color: var(--fep-on-accent);
    }
  }
</style>
