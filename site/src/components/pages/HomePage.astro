---
import Layout from '~/layouts/Layout.astro';
import BrandGrid from '~/components/BrandGrid.astro';
import BrandSearch from '~/components/BrandSearch.astro';
import { brands, categories, brandsInCategory, hasLandingPage, recentBrands, stats } from '~/lib/data.ts';
import { localized, paths, t, type Lang } from '~/lib/i18n.ts';
import { itemListJsonLd, websiteJsonLd } from '~/lib/seo.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternates = { pt: paths.home('pt'), en: paths.home('en') };
const recent = recentBrands(6);
const categoryCards = categories
  .map((category) => ({ category, count: brandsInCategory(category.id).length }))
  .filter((entry) => entry.count > 0)
  .sort((a, b) => b.count - a.count || a.category.label.pt.localeCompare(b.category.label.pt, 'pt'));
---

<Layout
  lang={lang}
  title={`${t(lang, 'site.name')} — ${t(lang, 'site.tagline')}`}
  description={t(lang, 'site.description')}
  canonical={paths.home(lang)}
  alternates={alternates}
  jsonLd={[websiteJsonLd(lang), itemListJsonLd(recent, lang)]}
>
  <div class="container">
    <section class="hero">
      <h1>{t(lang, 'home.title')}</h1>
      <p class="lede">{t(lang, 'home.intro')}</p>

      <div class="hero__search">
        <BrandSearch lang={lang} />
      </div>

      <dl class="stats">
        <div><dt>{t(lang, 'home.stats.brands')}</dt><dd>{stats.brands}</dd></div>
        <div><dt>{t(lang, 'home.stats.categories')}</dt><dd>{stats.categories}</dd></div>
        <div><dt>{t(lang, 'home.stats.regions')}</dt><dd>{stats.regions}</dd></div>
      </dl>
    </section>

    <section class="section">
      <h2>{t(lang, 'home.browseCategories')}</h2>
      <ul class="categories">
        {
          categoryCards.map(({ category, count }) => (
            <li>
              {hasLandingPage(category) ? (
                <a class="card category" href={paths.category(lang, category.slug[lang])}>
                  <span class="category__name">{localized(category.label, lang)}</span>
                  <span class="category__count muted">
                    {count === 1 ? t(lang, 'common.brandCount') : t(lang, 'common.brandsCount', { count })}
                  </span>
                </a>
              ) : (
                <span class="card category category--quiet">
                  <span class="category__name">{localized(category.label, lang)}</span>
                  <span class="category__count muted">
                    {count === 1 ? t(lang, 'common.brandCount') : t(lang, 'common.brandsCount', { count })}
                  </span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <p><a href={paths.categories(lang)}>{t(lang, 'nav.categories')}</a></p>
    </section>

    <section class="section">
      <h2>{t(lang, 'home.recentBrands')}</h2>
      <BrandGrid lang={lang} brands={recent} />
      <p class="more">
        <a href={paths.brands(lang)}>{t(lang, 'home.allBrands')} ({brands.length})</a>
      </p>
    </section>
  </div>
</Layout>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
    max-width: var(--container-narrow);
  }

  .hero h1 {
    font-size: var(--text-4xl);
  }

  .hero__search {
    margin-top: var(--space-5);
    max-width: 34rem;
  }

  .stats {
    display: flex;
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dt {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .stats dd {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
  }

  .categories {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .category {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
  }

  a.category:hover {
    border-color: var(--accent);
  }

  .category--quiet {
    opacity: 0.65;
  }

  .category__name {
    font-weight: 560;
  }

  .category__count {
    font-size: var(--text-sm);
  }

  .more {
    margin-top: var(--space-5);
  }
</style>
