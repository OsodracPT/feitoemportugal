---
/**
 * The contribution page: four web forms (suggest a brand, correct a brand,
 * request the badge, get in touch) that post to the submission service at
 * `/api/submit/*` on this same origin. Every form is a real `<form method=post>`
 * so it works with JavaScript off (a plain POST the service answers with a 303
 * to the thank-you page); `submit-form.ts` enhances it with Altcha and a fetch
 * submit when JS is on.
 *
 * The GitHub issue forms still exist, for people who prefer them, but they are
 * demoted here to a small link under each form — the point of the page is that
 * a visitor needs no GitHub account to contribute.
 */
import Layout from '~/layouts/Layout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { categories, regions } from '~/lib/data.ts';
import { issueForm } from '~/lib/config.ts';
import { paths, t, type Lang } from '~/lib/i18n.ts';
import { breadcrumbJsonLd, pageTitle, type Crumb } from '~/lib/seo.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternates = { pt: paths.submit('pt'), en: paths.submit('en') };
const brandPrefill = Astro.url.searchParams.get('brand') ?? '';
const crumbs: Crumb[] = [
  { name: t(lang, 'breadcrumbs.home'), path: paths.home(lang) },
  { name: t(lang, 'submitForm.title') },
];

const intents = ['brand', 'correction', 'verification', 'contact'] as const;
const ghTemplate = {
  brand: 'nova-marca.yml',
  correction: 'correcao.yml',
  verification: 'pedido-verificacao.yml',
} as const;

const districtOptions = regions.map((region) => ({ id: region.id, label: region.label[lang] }));
const categoryOptions = categories.map((category) => ({ id: category.id, label: category.label[lang] }));
---

<Layout
  lang={lang}
  title={pageTitle(t(lang, 'submitForm.title'), lang)}
  description={t(lang, 'submitForm.intro')}
  canonical={alternates[lang]}
  alternates={alternates}
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <div class="container narrow submit">
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <h1>{t(lang, 'submitForm.title')}</h1>
    <p class="lede">{t(lang, 'submitForm.intro')}</p>

    <nav class="submit__chooser" aria-label={t(lang, 'submitForm.title')}>
      {intents.map((intent) => (
        <a href={`#${intent}`}>{t(lang, `submitForm.chooser.${intent}`)}</a>
      ))}
    </nav>

    {/* ---------- Suggest a brand ---------- */}
    <section class="submit__section" id="brand">
      <h2>{t(lang, 'submitForm.brand.title')}</h2>
      <p class="submit__intro">{t(lang, 'submitForm.brand.intro')}</p>
      <p class="submit__success" data-submit-success hidden>{t(lang, 'submitForm.common.success')}</p>

      <form
        class="submit__form"
        method="post"
        action="/api/submit/brand"
        data-submit-form
        data-success={t(lang, 'submitForm.common.success')}
        data-error={t(lang, 'submitForm.common.error')}
        data-sending={t(lang, 'submitForm.common.sending')}
      >
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="altcha" />
        <p class="submit__hp" aria-hidden="true">
          <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="field">
          <span>{t(lang, 'submitForm.brand.name')}</span>
          <input name="name" required maxlength="120" />
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.website')}</span>
          <input name="website" type="url" required placeholder="https://" />
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.evidenceUrl')}</span>
          <input name="evidence_url" type="url" required placeholder="https://" />
          <small>{t(lang, 'submitForm.brand.evidenceUrlHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.evidenceQuote')}</span>
          <textarea name="evidence_quote" required rows="2"></textarea>
          <small>{t(lang, 'submitForm.brand.evidenceQuoteHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.scope')}</span>
          <select name="scope" required>
            <option value="total">{t(lang, 'submitForm.brand.scopeTotal')}</option>
            <option value="parcial">{t(lang, 'submitForm.brand.scopePartial')}</option>
          </select>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.scopeNotes')} <em>({t(lang, 'submitForm.common.optional')})</em></span>
          <textarea name="scope_notes" rows="2"></textarea>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.category')}</span>
          <select name="category" required>
            {categoryOptions.map((option) => <option value={option.id}>{option.label}</option>)}
          </select>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.district')} <em>({t(lang, 'submitForm.common.optional')})</em></span>
          <select name="district">
            <option value="">{t(lang, 'submitForm.brand.districtNone')}</option>
            {districtOptions.map((option) => <option value={option.id}>{option.label}</option>)}
          </select>
          <small>{t(lang, 'submitForm.brand.districtHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.municipality')} <em>({t(lang, 'submitForm.common.optional')})</em></span>
          <input name="municipality" maxlength="120" />
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.descriptionPt')}</span>
          <textarea name="description_pt" required rows="3"></textarea>
          <small>{t(lang, 'submitForm.brand.descriptionPtHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.brand.descriptionEn')} <em>({t(lang, 'submitForm.common.optional')})</em></span>
          <textarea name="description_en" rows="3"></textarea>
        </label>
        <label class="field">
          <span>Instagram <em>({t(lang, 'submitForm.common.optional')})</em></span>
          <input name="instagram" placeholder="nomedamarca" />
        </label>
        <label class="check">
          <input type="checkbox" name="relationship" value="owner" />
          <span>{t(lang, 'submitForm.brand.relationship')}</span>
        </label>
        <label class="check">
          <input type="checkbox" required />
          <span>{t(lang, 'submitForm.brand.confirmDescription')}</span>
        </label>
        <label class="check">
          <input type="checkbox" required />
          <span>{t(lang, 'submitForm.brand.confirmNoPersonal')}</span>
        </label>

        <p class="submit__status" data-submit-status hidden></p>
        <button class="button" type="submit">{t(lang, 'submitForm.common.send')}</button>
        <a class="submit__gh" href={issueForm(ghTemplate.brand)} rel="noopener">
          {t(lang, 'submitForm.github.lead')} {t(lang, 'submitForm.github.brand')}
        </a>
      </form>
    </section>

    {/* ---------- Correct a brand ---------- */}
    <section class="submit__section" id="correction">
      <h2>{t(lang, 'submitForm.correction.title')}</h2>
      <p class="submit__intro">{t(lang, 'submitForm.correction.intro')}</p>
      <p class="submit__success" data-submit-success hidden>{t(lang, 'submitForm.common.success')}</p>

      <form
        class="submit__form"
        method="post"
        action="/api/submit/correction"
        data-submit-form
        data-success={t(lang, 'submitForm.common.success')}
        data-error={t(lang, 'submitForm.common.error')}
        data-sending={t(lang, 'submitForm.common.sending')}
      >
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="altcha" />
        <p class="submit__hp" aria-hidden="true">
          <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="field">
          <span>{t(lang, 'submitForm.correction.brand')}</span>
          <input name="brand" required value={brandPrefill} />
          <small>{t(lang, 'submitForm.correction.brandHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.correction.details')}</span>
          <textarea name="details" required rows="4"></textarea>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.correction.source')} <em>({t(lang, 'submitForm.common.optional')})</em></span>
          <input name="source" type="url" placeholder="https://" />
          <small>{t(lang, 'submitForm.correction.sourceHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.common.email')}</span>
          <input name="email" type="email" />
          <small>{t(lang, 'submitForm.common.emailHelp')}</small>
        </label>

        <p class="submit__status" data-submit-status hidden></p>
        <button class="button" type="submit">{t(lang, 'submitForm.common.send')}</button>
        <a class="submit__gh" href={issueForm(ghTemplate.correction)} rel="noopener">
          {t(lang, 'submitForm.github.lead')} {t(lang, 'submitForm.github.correction')}
        </a>
      </form>
    </section>

    {/* ---------- Request the badge ---------- */}
    <section class="submit__section" id="verification">
      <h2>{t(lang, 'submitForm.verification.title')}</h2>
      <p class="submit__intro">{t(lang, 'submitForm.verification.intro')}</p>
      <p class="submit__success" data-submit-success hidden>{t(lang, 'submitForm.common.success')}</p>

      <form
        class="submit__form"
        method="post"
        action="/api/submit/verification"
        data-submit-form
        data-success={t(lang, 'submitForm.common.success')}
        data-error={t(lang, 'submitForm.common.error')}
        data-sending={t(lang, 'submitForm.common.sending')}
      >
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="altcha" />
        <p class="submit__hp" aria-hidden="true">
          <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="field">
          <span>{t(lang, 'submitForm.verification.brand')}</span>
          <input name="brand" required value={brandPrefill} />
          <small>{t(lang, 'submitForm.verification.brandHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.verification.details')}</span>
          <textarea name="details" required rows="4"></textarea>
          <small>{t(lang, 'submitForm.verification.detailsHelp')}</small>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.common.email')}</span>
          <input name="email" type="email" />
          <small>{t(lang, 'submitForm.common.emailHelp')}</small>
        </label>
        <label class="check">
          <input type="checkbox" name="confirm" value="sim" required />
          <span>{t(lang, 'submitForm.verification.confirm')}</span>
        </label>

        <p class="submit__status" data-submit-status hidden></p>
        <button class="button" type="submit">{t(lang, 'submitForm.common.send')}</button>
        <a class="submit__gh" href={issueForm(ghTemplate.verification)} rel="noopener">
          {t(lang, 'submitForm.github.lead')} {t(lang, 'submitForm.github.verification')}
        </a>
      </form>
    </section>

    {/* ---------- Get in touch ---------- */}
    <section class="submit__section" id="contact">
      <h2>{t(lang, 'submitForm.contact.title')}</h2>
      <p class="submit__intro">{t(lang, 'submitForm.contact.intro')}</p>
      <p class="submit__success" data-submit-success hidden>{t(lang, 'submitForm.common.success')}</p>

      <form
        class="submit__form"
        method="post"
        action="/api/submit/contact"
        data-submit-form
        data-success={t(lang, 'submitForm.common.success')}
        data-error={t(lang, 'submitForm.common.error')}
        data-sending={t(lang, 'submitForm.common.sending')}
      >
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="altcha" />
        <p class="submit__hp" aria-hidden="true">
          <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="field">
          <span>{t(lang, 'submitForm.contact.message')}</span>
          <textarea name="message" required rows="4"></textarea>
        </label>
        <label class="field">
          <span>{t(lang, 'submitForm.common.email')}</span>
          <input name="email" type="email" />
          <small>{t(lang, 'submitForm.common.emailHelp')}</small>
        </label>

        <p class="submit__status" data-submit-status hidden></p>
        <button class="button" type="submit">{t(lang, 'submitForm.common.send')}</button>
      </form>
    </section>
  </div>
</Layout>

<script>
  import { initSubmitForms } from '~/lib/submit-form.ts';
  initSubmitForms();
</script>

<style>
  .narrow {
    max-width: var(--container-narrow);
  }

  .submit__chooser {
    display: flex;
    flex-wrap: wrap;
    gap: var(--fep-space-2);
    margin-block: var(--fep-space-4) var(--fep-space-6);
  }

  .submit__chooser a {
    padding: var(--fep-space-2) var(--fep-space-3);
    border: var(--fep-stitch);
    border-radius: var(--fep-radius-lg);
    font-size: var(--fep-text-sm);
    font-weight: 650;
    text-decoration: none;
    color: var(--fep-heading);
    background: var(--fep-surface);
  }

  .submit__section {
    padding-top: var(--fep-space-6);
    margin-top: var(--fep-space-6);
    border-top: 1px solid var(--fep-line);
    scroll-margin-top: var(--fep-space-6);
  }

  .submit__intro {
    color: var(--fep-ink-2);
  }

  .submit__form {
    display: grid;
    gap: var(--fep-space-4);
    margin-top: var(--fep-space-4);
  }

  .field {
    display: grid;
    gap: var(--fep-space-1);
  }

  .field > span {
    font-weight: 650;
    color: var(--fep-heading);
  }

  .field em {
    font-style: normal;
    font-weight: 400;
    color: var(--fep-ink-2);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: var(--fep-space-2) var(--fep-space-3);
    border: 1px solid var(--fep-line);
    border-radius: var(--fep-radius-md);
    background: var(--fep-bg);
    color: var(--fep-ink);
    font: inherit;
  }

  .field textarea {
    resize: vertical;
  }

  .field small {
    color: var(--fep-ink-2);
    font-size: var(--fep-text-sm);
  }

  .check {
    display: flex;
    gap: var(--fep-space-2);
    align-items: start;
    color: var(--fep-ink);
  }

  .check input {
    margin-top: 0.2em;
  }

  /* The honeypot: present in the DOM for bots, invisible and unreachable for people. */
  .submit__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit__status {
    margin: 0;
    font-weight: 650;
  }

  .submit__status[data-kind='error'] {
    color: var(--fep-danger, #b3261e);
  }

  .submit__success {
    padding: var(--fep-space-3) var(--fep-space-4);
    border: var(--fep-stitch);
    border-radius: var(--fep-radius-lg);
    background: var(--fep-surface);
    font-weight: 650;
    color: var(--fep-heading);
  }

  .submit__gh {
    justify-self: start;
    font-size: var(--fep-text-sm);
    color: var(--fep-ink-2);
  }
</style>
