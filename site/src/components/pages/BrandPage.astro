---
import type { Brand } from '@fep/schema';
import { getImage, Image, Picture } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Badges from '~/components/Badges.astro';
import BrandGrid from '~/components/BrandGrid.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import PriceRange from '~/components/PriceRange.astro';
import { SITE } from '~/lib/config.ts';
import {
  getCategory,
  getCertification,
  getMunicipality,
  getPractice,
  getProduct,
  getRegion,
  getSubcategory,
  getTag,
  hasLandingPage,
  hasProductPage,
  hasRegionPage,
  hasTagPage,
  relatedBrands,
} from '~/lib/data.ts';
import { formatDate, localized, paths, t, type Lang } from '~/lib/i18n.ts';
import { brandLogo, brandPhotos } from '~/lib/media.ts';
import {
  brandDescription,
  brandJsonLd,
  brandOgImagePath,
  brandTitle,
  breadcrumbJsonLd,
  socialLinks,
  type Crumb,
} from '~/lib/seo.ts';

interface Props {
  lang: Lang;
  brand: Brand;
}

const { lang, brand } = Astro.props;
const logo = brandLogo(brand);
const photos = brandPhotos(brand);
// Structured data wants a stable, crawlable file: SVG logos pass through as they
// are (Astro does not rasterise SVG by default), rasters get a PNG copy.
const logoFile = logo
  ? await getImage(logo.format === 'svg' ? { src: logo, format: 'svg' } : { src: logo, format: 'png', height: 256 })
  : undefined;

const category = getCategory(brand.category);
const subcategory = brand.subcategory ? getSubcategory(brand.category, brand.subcategory) : undefined;
const region = brand.location ? getRegion(brand.location.district) : undefined;
const municipality =
  brand.location?.municipality && region
    ? getMunicipality(region.id, brand.location.municipality)
    : undefined;

const alternates = {
  pt: paths.brand('pt', brand.slug),
  en: paths.brand('en', brand.slug),
};

const crumbs: Crumb[] = [
  { name: t(lang, 'breadcrumbs.home'), path: paths.home(lang) },
  { name: t(lang, 'brands.title'), path: paths.brands(lang) },
  ...(category && hasLandingPage(category)
    ? [{ name: localized(category.label, lang), path: paths.category(lang, category.slug[lang]) }]
    : []),
  { name: brand.name },
];

const related = relatedBrands(brand, 4);
const social = socialLinks(brand);
const practices = brand.sustainability?.practices.map(getPractice).filter(Boolean) ?? [];
const certifications = brand.sustainability?.certifications ?? [];
const notes = brand.production.notes ? localized(brand.production.notes, lang) : '';
const products = brand.products.flatMap((id) => {
  const product = getProduct(id);
  return product ? [product] : [];
});
const evidenceUrl = `${SITE.repo}/tree/main/docs/leads`;

const correctionUrl = `${SITE.repo}/issues/new?labels=correcao&template=correcao.yml&title=${encodeURIComponent(
  `[correção] ${brand.name}`,
)}&brand=${encodeURIComponent(brand.slug)}`;

const locationLabel = [municipality?.name, region ? localized(region.label, lang) : null]
  .filter(Boolean)
  .join(', ');
---

<Layout
  lang={lang}
  title={brandTitle(brand, { category, subcategory, regionLabel: region ? localized(region.label, lang) : undefined }, lang)}
  description={brandDescription(brand, lang)}
  canonical={alternates[lang]}
  alternates={alternates}
  ogImage={brandOgImagePath(lang, brand.slug)}
  jsonLd={[
    brandJsonLd(brand, lang, {
      category,
      subcategory,
      districtLabel: region ? localized(region.label, lang) : undefined,
      logoPath: logoFile?.src,
    }),
    breadcrumbJsonLd(crumbs),
  ]}
>
  <div class="container brand">
    <Breadcrumbs lang={lang} crumbs={crumbs} />

    <header class="brand__header">
      {
        logo && (
          <span class="brand__logo">
            <Image src={logo} alt="" height={128} densities={[1]} loading="eager" />
          </span>
        )
      }
      <h1>{brand.name}</h1>
      <Badges lang={lang} brand={brand} withDate />
      <p class="lede">{localized(brand.description, lang)}</p>
      <p class="brand__actions">
        <a class="button" href={brand.website} rel="nofollow noopener">
          {t(lang, 'brand.visitWebsite')}
          <span class="visually-hidden"> ({t(lang, 'common.externalLink')})</span>
        </a>
      </p>
    </header>

    {
      photos.length > 0 && (
        <figure class="brand__photos">
          <ul>
            {photos.map((photo, index) => (
              <li>
                <Picture
                  src={photo}
                  alt={t(lang, 'brand.photoAlt', { name: brand.name, n: String(index + 1) })}
                  formats={['avif', 'webp']}
                  widths={[400, 800]}
                  sizes="(min-width: 52rem) 25vw, 50vw"
                  loading="lazy"
                />
              </li>
            ))}
          </ul>
          <figcaption>{t(lang, 'brand.photoCredit', { name: brand.name })}</figcaption>
        </figure>
      )
    }

    <div class="brand__grid">
      <section class="brand__facts">
        <h2 class="eyebrow">{t(lang, 'brand.details')}</h2>
        <dl class="facts">
          <div>
            <dt>{t(lang, 'brand.production')}</dt>
            <dd>
              {brand.production.scope === 'parcial'
                ? t(lang, 'brand.productionPartial')
                : t(lang, 'brand.productionTotal')}
              {notes && <><br /><span class="muted">{notes}</span></>}
            </dd>
          </div>

          {
            category && (
              <div>
                <dt>{t(lang, 'brand.category')}</dt>
                <dd>
                  {hasLandingPage(category) ? (
                    <a href={paths.category(lang, category.slug[lang])}>
                      {localized(category.label, lang)}
                    </a>
                  ) : (
                    localized(category.label, lang)
                  )}
                  {subcategory && <> · {localized(subcategory.label, lang)}</>}
                </dd>
              </div>
            )
          }

          {
            products.length > 0 && (
              <div>
                <dt>{t(lang, 'brand.products')}</dt>
                <dd>
                  {products.map((product, index) => (
                    <>
                      {index > 0 && ', '}
                      {hasProductPage(product.id) ? (
                        <a href={paths.product(lang, product.slug[lang])}>{localized(product.label, lang)}</a>
                      ) : (
                        localized(product.label, lang)
                      )}
                    </>
                  ))}
                </dd>
              </div>
            )
          }

          {
            locationLabel && (
              <div>
                <dt>{t(lang, 'brand.location')}</dt>
                <dd>
                  {region && hasRegionPage(region.id) ? (
                    <>
                      {municipality && <>{municipality.name}, </>}
                      <a href={paths.region(lang, region.slug[lang])}>{localized(region.label, lang)}</a>
                    </>
                  ) : (
                    locationLabel
                  )}
                </dd>
              </div>
            )
          }

          {
            brand.founded && (
              <div>
                <dt>{t(lang, 'brand.founded')}</dt>
                <dd>{brand.founded}</dd>
              </div>
            )
          }

          {
            brand.price_range && (
              <div>
                <dt>{t(lang, 'brand.priceRange')}</dt>
                <dd><PriceRange lang={lang} value={brand.price_range} category={category} /></dd>
              </div>
            )
          }

          <div>
            <dt>{t(lang, 'brand.website')}</dt>
            <dd>
              <a href={brand.website} rel="nofollow noopener">{new URL(brand.website).host.replace(/^www\./, '')}</a>
            </dd>
          </div>
        </dl>

        {
          brand.tags.length > 0 && (
            <>
              <h2 class="eyebrow">{t(lang, 'brand.tags')}</h2>
              <ul class="pill-list">
                {brand.tags.map((tagId) => {
                  const tag = getTag(tagId);
                  if (!tag) return null;
                  return (
                    <li>
                      {hasTagPage(tag.id) ? (
                        <a class="pill" href={paths.tag(lang, tag.id)}>{localized(tag.label, lang)}</a>
                      ) : (
                        <span class="pill">{localized(tag.label, lang)}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </>
          )
        }
      </section>

      <aside class="brand__aside stack">
        <section class="evidence">
          <h2 class="eyebrow">{t(lang, 'brand.howWeKnow')}</h2>
          <p>
            {brand.meta.source === 'maintainer' ? t(lang, 'brand.howMaintainer') : t(lang, 'brand.howImport')}
          </p>
          {brand.meta.source !== 'maintainer' && (
            <p><a href={evidenceUrl} rel="noopener">{t(lang, 'brand.evidenceLink')}</a></p>
          )}
          <p class="muted">
            {brand.verification?.verified && brand.verification.date
              ? t(lang, 'brand.verifiedOn', { date: formatDate(brand.verification.date, lang) })
              : t(lang, 'brand.howNotVerified')}
          </p>
        </section>

        {
          (brand.where_to_buy?.online_store ||
            (brand.where_to_buy?.physical_stores.length ?? 0) > 0 ||
            (brand.where_to_buy?.marketplaces.length ?? 0) > 0) && (
            <section>
              <h2 class="eyebrow">{t(lang, 'brand.whereToBuy')}</h2>
              <ul class="links">
                {brand.where_to_buy?.online_store && (
                  <li>
                    <a href={brand.where_to_buy.online_store} rel="nofollow noopener">
                      {t(lang, 'brand.onlineStore')}
                    </a>
                  </li>
                )}
                {brand.where_to_buy?.marketplaces.map((url) => (
                  <li>
                    <a href={url} rel="nofollow noopener">{new URL(url).host.replace(/^www\./, '')}</a>
                  </li>
                ))}
                {brand.where_to_buy?.physical_stores.map((store) => (
                  <li>
                    {store.url ? (
                      <a href={store.url} rel="nofollow noopener">{store.name}</a>
                    ) : (
                      store.name
                    )}
                    <span class="muted"> · {store.city}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          social.length > 0 && (
            <section>
              <h2 class="eyebrow">{t(lang, 'brand.social')}</h2>
              <ul class="links">
                {social.map((link) => (
                  <li>
                    <a href={link.url} rel="nofollow noopener">{link.network}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (practices.length > 0 || certifications.length > 0) && (
            <section>
              <h2 class="eyebrow">{t(lang, 'brand.sustainability')}</h2>
              {practices.length > 0 && (
                <ul class="pill-list">
                  {practices.map((practice) => (
                    <li class="pill">{practice && localized(practice.label, lang)}</li>
                  ))}
                </ul>
              )}
              {certifications.length > 0 && (
                <ul class="links">
                  {certifications.map((certification) => {
                    const definition = getCertification(certification.id);
                    return (
                      <li>
                        {definition ? localized(definition.label, lang) : certification.id}
                        {certification.proof_url && (
                          <>
                            {' '}
                            <a href={certification.proof_url} rel="nofollow noopener">
                              ({t(lang, 'brand.proof')})
                            </a>
                          </>
                        )}
                      </li>
                    );
                  })}
                </ul>
              )}
            </section>
          )
        }

        <section class="meta">
          <p class="muted">
            {t(lang, 'brand.addedOn', { date: formatDate(brand.meta.added, lang) })}<br />
            {t(lang, 'brand.updatedOn', { date: formatDate(brand.meta.updated, lang) })}
          </p>
          <p><a href={correctionUrl} rel="nofollow noopener">{t(lang, 'brand.suggestCorrection')}</a></p>
        </section>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="section related">
          <h2>{t(lang, 'brand.related')}</h2>
          <BrandGrid lang={lang} brands={related} />
        </section>
      )
    }
  </div>
</Layout>

<style>
  .brand__header {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-6);
  }

  /* Logos are drawn for light backgrounds, so they keep a light plate in dark mode. */
  .brand__logo {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--logo-plate);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .brand__logo img {
    display: block;
    width: auto;
    max-width: min(16rem, 70vw);
    height: auto;
    max-height: 4rem;
    object-fit: contain;
  }

  .brand__photos {
    margin: 0 0 var(--space-6);
  }

  .brand__photos ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .brand__photos img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--bg-sunken);
  }

  .brand__photos figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (min-width: 52rem) {
    .brand__photos ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .brand__header h1 {
    margin-bottom: var(--space-3);
  }

  .brand__header .lede {
    margin-top: var(--space-4);
  }

  .brand__actions {
    margin: var(--space-5) 0 0;
  }

  .brand__grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 52rem) {
    .brand__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-7);
    }
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
  }

  .facts dt {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .facts dd {
    margin: var(--space-1) 0 0;
  }

  .brand__aside {
    border-top: 1px solid var(--line);
    padding-top: var(--space-5);
  }

  @media (min-width: 52rem) {
    .brand__aside {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 var(--space-6);
    }
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .meta {
    font-size: var(--text-sm);
  }

  .meta p {
    margin-bottom: var(--space-2);
  }

  .related {
    margin-top: var(--space-8);
  }
</style>
