---
/**
 * What the verified seal means, how a brand gets it, and which brands have it.
 * Maintainers approve requests by hand and fill the brand's `verification`
 * block; this page only explains that and lists the result.
 */
import Layout from '~/layouts/Layout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import BrandGrid from '~/components/BrandGrid.astro';
import { SITE, issueForm } from '~/lib/config.ts';
import { brands } from '~/lib/data.ts';
import { emptyFilters, serializeListingState } from '~/lib/filters.ts';
import { paths, t, type Lang } from '~/lib/i18n.ts';
import { breadcrumbJsonLd, pageTitle, type Crumb } from '~/lib/seo.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternates = { pt: paths.badge('pt'), en: paths.badge('en') };
const crumbs: Crumb[] = [
  { name: t(lang, 'breadcrumbs.home'), path: paths.home(lang) },
  { name: t(lang, 'badge.title') },
];

const verified = brands.filter((brand) => brand.verification?.verified);
const filters = { ...emptyFilters(), verified: ['yes'] };
const catalogueLink = `${paths.brands(lang)}${serializeListingState({ q: '', sort: 'relevance', filters })}`;


const sections: { id: string; links?: { href: string; label: string }[] }[] = [
  { id: 'meaning', links: [{ href: paths.about(lang), label: t(lang, 'badge.links.criteria') }] },
  { id: 'evidence' },
  {
    id: 'process',
    links: [
      { href: issueForm('pedido-verificacao.yml'), label: t(lang, 'badge.links.request') },
      { href: `${SITE.repo}/blob/main/CONTRIBUTING.md`, label: t(lang, 'badge.links.guide') },
    ],
  },
  { id: 'revoke', links: [{ href: issueForm('correcao.yml'), label: t(lang, 'badge.links.correct') }] },
];
---

<Layout
  lang={lang}
  title={pageTitle(t(lang, 'badge.title'), lang)}
  description={t(lang, 'badge.intro')}
  canonical={alternates[lang]}
  alternates={alternates}
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <div class="container narrow">
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <h1>{t(lang, 'badge.title')}</h1>
    <p class="lede">{t(lang, 'badge.intro')}</p>

    {
      sections.map((section) => (
        <section class="section" id={section.id}>
          <h2>{t(lang, `badge.sections.${section.id}.title`)}</h2>
          <p>{t(lang, `badge.sections.${section.id}.body`)}</p>
          {section.links && (
            <ul class="badge-page__links">
              {section.links.map((link) => (
                <li>
                  <a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>

  <section class="container section" id="verified">
    <h2>{t(lang, 'badge.listTitle')}</h2>
    {
      verified.length === 0 ? (
        <p class="muted">{t(lang, 'badge.empty')}</p>
      ) : (
        <>
          <p><a href={catalogueLink}>{t(lang, 'badge.links.filter')}</a></p>
          <BrandGrid lang={lang} brands={verified} />
        </>
      )
    }
  </section>
</Layout>

<style>
  .narrow {
    max-width: var(--container-narrow);
  }

  .badge-page__links {
    padding-left: 1.2em;
  }

  .badge-page__links li + li {
    margin-top: var(--space-2);
  }
</style>
