---
import Layout from '~/layouts/Layout.astro';
import BrandBrowser from '~/components/BrandBrowser.astro';
import BrandFilters from '~/components/BrandFilters.astro';
import BrandGrid from '~/components/BrandGrid.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { brands, categories, brandsInCategory, hasLandingPage } from '~/lib/data.ts';
import { localized, paths, t, type Lang } from '~/lib/i18n.ts';
import { breadcrumbJsonLd, itemListJsonLd, pageTitle, type Crumb } from '~/lib/seo.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternates = { pt: paths.brands('pt'), en: paths.brands('en') };
const crumbs: Crumb[] = [
  { name: t(lang, 'breadcrumbs.home'), path: paths.home(lang) },
  { name: t(lang, 'brands.title') },
];
const withBrands = categories
  .map((category) => ({ category, count: brandsInCategory(category.id).length }))
  .filter((entry) => entry.count > 0);

/** Ties the toolbar button to the panel it opens. */
const filtersId = 'brand-filters';
---

<Layout
  lang={lang}
  title={pageTitle(`${t(lang, 'brands.title')} (${brands.length})`, lang)}
  description={t(lang, 'brands.intro')}
  canonical={paths.brands(lang)}
  alternates={alternates}
  jsonLd={[itemListJsonLd(brands, lang), breadcrumbJsonLd(crumbs)]}
>
  <!-- On desktop the calçada divider runs under the header; on a phone, under the toolbar. -->
  <div class="band band--wide" aria-hidden="true"></div>
  <div class="container">
    <Breadcrumbs lang={lang} crumbs={crumbs} />

    <div class="listing">
      <BrandFilters lang={lang} id={filtersId} />

      <div class="listing__main">
        <div class="listing__head">
          <h1 class="plate">{t(lang, 'brands.title')}</h1>
          <p class="listing__count">
            <span data-brand-total>
              {brands.length === 1 ? t(lang, 'brands.countOne') : t(lang, 'brands.count', { count: brands.length })}
            </span>
            <span role="status" aria-live="polite" data-status></span>
          </p>
        </div>

        <BrandBrowser lang={lang} filtersId={filtersId} />
        <div class="band band--narrow" aria-hidden="true"></div>

        <BrandGrid lang={lang} brands={brands} />

        <!-- Degraded, no-JavaScript browsing by category. -->
        <nav class="by-category" aria-label={t(lang, 'brands.byCategory')}>
          <h2 class="by-category__title">{t(lang, 'brands.byCategory')}</h2>
          <ul class="pill-list">
            {
              withBrands.map(({ category, count }) =>
                hasLandingPage(category) ? (
                  <li>
                    <a class="pill" href={paths.category(lang, category.slug[lang])}>
                      {localized(category.label, lang)} <span class="muted">{count}</span>
                    </a>
                  </li>
                ) : (
                  <li>
                    <span class="pill pill--quiet">
                      {localized(category.label, lang)} <span class="muted">{count}</span>
                    </span>
                  </li>
                ),
              )
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Decorative: nothing sits on the pattern. */
  .band {
    height: 22px;
    background: var(--fep-calcada);
  }

  .band--wide {
    display: none;
  }

  /* Full bleed inside the gutter. */
  .band--narrow {
    margin-inline: calc(-1 * var(--fep-gutter));
    margin-bottom: var(--fep-space-3);
  }

  .listing__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--fep-space-2) var(--fep-space-3);
  }

  .listing__count {
    margin: 0;
    font-size: var(--fep-text-xs);
    color: var(--fep-ink-2);
  }

  .listing__count [data-brand-total][hidden] {
    display: none;
  }

  .by-category {
    margin-block: var(--fep-space-12) 0;
    padding-top: var(--fep-space-6);
    border-top: 1px solid var(--fep-line);
  }

  .by-category__title {
    font-size: var(--fep-display-3);
    margin: 0 0 var(--fep-space-3);
  }

  @media (min-width: 60rem) {
    /* Straight under the header: cancel the top padding of <main>. */
    .band--wide {
      display: block;
      height: 24px;
      margin: calc(-1 * var(--space-6)) 0 var(--fep-space-5);
    }

    .band--narrow {
      display: none;
    }

    /* Two columns only once the controller has shown the panel. */
    .listing:has(> [data-filters-panel]:not([hidden])) {
      display: grid;
      grid-template-columns: minmax(16rem, 20rem) minmax(0, 1fr);
      gap: var(--fep-space-10);
      align-items: start;
    }

    .listing__count {
      font-size: var(--fep-text);
    }
  }
</style>
