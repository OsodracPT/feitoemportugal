---
import DistrictMap from '~/components/DistrictMap.astro';
import { filterGroups } from '~/lib/filter-groups.ts';
import { t, type Lang } from '~/lib/i18n.ts';

interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const groups = filterGroups(lang);
const districtGroup = groups.find((group) => group.key === 'dist');
const districtCounts = new Map(districtGroup?.options.map((option) => [option.value, option.count]));
---

<!--
  Groups with no brand behind them are not rendered at all, so "verified" only
  appears once a brand is verified. `data-open` is what the toolbar button
  toggles on narrow screens; wide screens ignore it and keep the panel open.
-->
<div class="facets" id={id} data-filters-panel data-open="false" hidden>
  <div class="facets__head">
    <h2 class="facets__title">{t(lang, 'filters.title')}</h2>
    <button class="facets__clear" type="button" data-filters-clear hidden>
      {t(lang, 'filters.clear')}
    </button>
  </div>

  {
    districtGroup && (
      <div class="facets__map">
        <DistrictMap lang={lang} mode="filter" counts={districtCounts} />
      </div>
    )
  }

  {
    groups.map((group) => (
      <details class="facet" data-group={group.key} data-depends-on={group.dependsOn} open={group.key === 'cat'}>
        <summary class="facet__summary">
          <span>{group.label}</span>
          <span class="facet__badge" data-group-count hidden></span>
        </summary>
        <ul class="facet__options" role="group" aria-label={group.label}>
          {group.options.map((option) => (
            <li class="facet__option" data-value={option.value} data-parent={option.parent}>
              <label>
                <input type="checkbox" name={group.key} value={option.value} />
                <span class="facet__label" title={option.hint}>{option.label}</span>
                <span class="facet__count" data-option-count>{option.count}</span>
              </label>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</div>

<style>
  /* Sidebar on wide screens; a drop-down under the toolbar below 900px. */
  @media (max-width: 899px) {
    .facets[data-open='false'] {
      display: none;
    }
  }

  .facets {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    padding: var(--space-3) var(--space-4);
  }

  .facets__map {
    padding-block: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  /* In the narrow panel (and the mobile drop-down) the map is a control, not
     the point of the page: keep it short enough to reach the groups below. */
  .facets__map :global(svg) {
    max-height: 18rem;
  }

  .facets__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-1) var(--space-2);
  }

  .facets__title {
    margin: 0;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .facets__clear {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .facet {
    border-top: 1px solid var(--line);
  }

  .facet[hidden] {
    display: none;
  }

  .facet__summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
    cursor: pointer;
    font-weight: 560;
    list-style: none;
  }

  .facet__summary::-webkit-details-marker {
    display: none;
  }

  /* Disclosure triangle, rotated when open. */
  .facet__summary::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    border-right: 1.5px solid var(--text-faint);
    border-bottom: 1.5px solid var(--text-faint);
    rotate: -45deg;
    transition: rotate 120ms ease;
  }

  .facet[open] > .facet__summary::before {
    rotate: 45deg;
  }

  .facet__summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  .facet__badge {
    margin-inline-start: auto;
    min-width: 1.35rem;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: center;
  }

  .facet__options {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-3);
    /* Long groups (tags, subcategories) scroll instead of pushing the grid down. */
    max-height: 15rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .facet__option label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.2rem 0;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .facet__option input {
    flex: none;
    accent-color: var(--accent);
  }

  .facet__label {
    flex: 1;
    min-width: 0;
  }

  .facet__count {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
  }

  /* No brand left in this option under the current filters. */
  .facet__option[data-empty] label {
    cursor: default;
    color: var(--text-faint);
  }

  .facet__option[hidden] {
    display: none;
  }
</style>
