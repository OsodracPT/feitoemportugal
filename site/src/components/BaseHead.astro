---
import { OG_LOCALE, otherLang, t, type Alternates, type Lang } from '~/lib/i18n.ts';
import { absolute, hreflangLinks, type JsonLdNode } from '~/lib/seo.ts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page, used as the canonical URL. */
  canonical: string;
  alternates: Alternates;
  /** Filtered, paginated or search pages must not be indexed. */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: JsonLdNode[];
}

const {
  lang,
  title,
  description,
  canonical,
  alternates,
  noindex = false,
  ogType = 'website',
  ogImage = '/og-default.png',
  jsonLd = [],
} = Astro.props;

const alternateLinks = hreflangLinks(alternates);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={absolute(canonical)} />
{noindex && <meta name="robots" content="noindex, follow" />}

{
  alternateLinks.map((link) => (
    <link rel="alternate" hreflang={link.hreflang} href={link.href} />
  ))
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={t(lang, 'site.name')} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:locale:alternate" content={OG_LOCALE[otherLang(lang)]} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={absolute(canonical)} />
<meta property="og:image" content={absolute(ogImage)} />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/brand/monogram.svg" />
<link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#15150F" media="(prefers-color-scheme: dark)" />

{
  jsonLd.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))
}
