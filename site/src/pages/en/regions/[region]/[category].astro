---
import type { GetStaticPaths } from 'astro';
import RegionCategoryPage from '~/components/pages/RegionCategoryPage.astro';
import { landingRegionCategories } from '~/lib/data.ts';

export const getStaticPaths = (() =>
  landingRegionCategories().map(({ region, category }) => ({
    params: { region: region.slug.en, category: category.slug.en },
    props: { region, category },
  }))) satisfies GetStaticPaths;

const { region, category } = Astro.props;
---

<RegionCategoryPage lang="en" region={region} category={category} />
