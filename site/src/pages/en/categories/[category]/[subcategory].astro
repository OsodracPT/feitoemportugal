---
import type { GetStaticPaths } from 'astro';
import CategoryPage from '~/components/pages/CategoryPage.astro';
import { landingCategories, landingSubcategories } from '~/lib/data.ts';

export const getStaticPaths = (() =>
  landingCategories().flatMap((category) =>
    landingSubcategories(category).map((subcategory) => ({
      params: { category: category.slug.en, subcategory: subcategory.slug.en },
      props: { category, subcategory },
    })),
  )) satisfies GetStaticPaths;

const { category, subcategory } = Astro.props;
---

<CategoryPage lang="en" category={category} subcategory={subcategory} />
