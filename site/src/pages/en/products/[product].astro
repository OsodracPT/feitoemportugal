---
import type { GetStaticPaths } from 'astro';
import TermPage from '~/components/pages/TermPage.astro';
import { landingProducts } from '~/lib/data.ts';

export const getStaticPaths = (() =>
  landingProducts().map((product) => ({
    params: { product: product.slug.en },
    props: { product },
  }))) satisfies GetStaticPaths;

const { product } = Astro.props;
---

<TermPage lang="en" kind="product" term={product} />
