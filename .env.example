# Reference environment for a self-hosted deploy. Copy to deploy/.env (next to
# docker-compose.yml) and fill in. Secrets stay here only, never in the repo.
#
#   cp .env.example deploy/.env

# ---- Static site (the `web` service) --------------------------------------
FEP_WWW_DIR=./www          # directory holding current/ (the build, or a release symlink)
FEP_BIND=127.0.0.1         # 127.0.0.1: only a local reverse proxy reaches it; 0.0.0.0 exposes it
FEP_PORT=8080

# ---- Submission service (the optional `submit` service) -------------------
# Everything below is read by submit-api; all have safe defaults, so the
# service also runs locally with none of it (mail is logged, no PR is opened).

# Where the static site lives. Used for the thank-you redirect and to read the
# existing brands (/api/v1/brands.json) for slug/website dedup.
SITE_ORIGIN=https://feitoemportugal.org

# Signs Altcha challenges and hashes stored IPs. REQUIRED in production — set a
# long random string (e.g. `openssl rand -hex 32`). The dev default is insecure.
SECRET_KEY=

# Reject a POST with no valid Altcha solution. Keep off (the default) so the
# forms still work with JavaScript disabled; honeypot + rate limit cover that.
ALTCHA_REQUIRED=false

# Per-IP rate limit.
RATE_WINDOW_SECONDS=3600
RATE_MAX=5

# Days a submission row is kept before the daily sweep deletes it.
RETENTION_DAYS=90

# SMTP for the maintainer notification email (nodemailer). Leave unset to only
# log the mail. Any SMTP works; defaults below are Namecheap Private Email, the
# mailbox hosting this project uses — see deploy/README.md.
# Private Email: host mail.privateemail.com, port 587 (STARTTLS) or 465 (SSL).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_SECURE=false          # false for 587 (STARTTLS); true for 465 (SSL)
SMTP_USER=geral@feitoemportugal.org   # full mailbox address is the login
SMTP_PASS=                 # the mailbox password
MAIL_FROM=geral@feitoemportugal.org   # the mailbox address
MAIL_TO=geral@feitoemportugal.org     # where submissions land (same mailbox)

# GitHub, for auto-opening a draft-brand PR on a clean new-brand submission.
# Leave unset to email only (no PR). The token needs repo contents + PR scope.
GITHUB_TOKEN=
GITHUB_REPO=               # owner/repo, e.g. OsodracPT/feitoemportugal
GITHUB_BASE=main
